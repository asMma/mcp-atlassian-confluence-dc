{
  "servers": {
    "confluence-dc": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "--project", "/chemin/vers/mcp-atlassian", "--frozen",
        "mcp-atlassian"
      ],
      "env": {
        "CONFLUENCE_URL": "https://confluence.tonentreprise.com",
        "CONFLUENCE_PERSONAL_TOKEN": "${input:confluencePat}",
        "CONFLUENCE_SSL_VERIFY": "true",
        "CONFLUENCE_SPACES_FILTER": "${input:confluenceSpacesFilter}"
      }
    },
    "jira-dc": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run", "--project", "/chemin/vers/mcp-atlassian", "--frozen",
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://jira.tonentreprise.com",
        "JIRA_PERSONAL_TOKEN": "${input:jiraPat}",
        "JIRA_SSL_VERIFY": "true",
        "JIRA_PROJECTS_FILTER": "${input:jiraProjectsFilter}"
      }
    }
  },
  "inputs": [
    {
      "id": "confluencePat",
      "type": "promptString",
      "description": "Confluence Data Center Personal Access Token",
      "password": true
    },
    {
      "id": "jiraPat",
      "type": "promptString",
      "description": "Jira Data Center Personal Access Token",
      "password": true
    },
    {
      "id": "confluenceSpacesFilter",
      "type": "promptString",
      "description": "Clés des espaces Confluence autorisés, séparées par des virgules (ex: DEV,TEAM). Laisser vide = tous les espaces accessibles au jeton.",
      "default": ""
    },
    {
      "id": "jiraProjectsFilter",
      "type": "promptString",
      "description": "Clés des projets Jira autorisés, séparées par des virgules (ex: SUPPORT,PROD). Laisser vide = tous les projets accessibles au jeton.",
      "default": ""
    }
  ]
}
